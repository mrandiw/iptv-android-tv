<?xml version="1.0" encoding="utf-8"?>
<!-- Many public IPTV streams are plain HTTP, so cleartext must be allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
